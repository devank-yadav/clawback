{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make eval)",
      "Bash(make check-data)",
      "Bash(pytest *)",
      "Bash(python scripts/check_data.py)",
      "Bash(python scripts/check_eval.py)",
      "Bash(npm run lint)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
