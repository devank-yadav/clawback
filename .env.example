# Copy to .env and fill in. Never commit .env. Names only here.

# Database (Tiger Data / Tiger Cloud)
DATABASE_URL=

# AI models
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Reader B's model; empty means gemini-2.5-flash (api/agents/reader_b.py)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# One Claude agent on another model, e.g. claude-sonnet-5-5 for the Investigator, checked with make eval-agent; empty
# means claude-opus-5-5 (api/agents/claude.py). READER covers both Claude reads of a document.
CLAWBACK_MODEL_READER=
CLAWBACK_MODEL_INVESTIGATOR=
CLAWBACK_MODEL_REHEARSAL=
CLAWBACK_MODEL_PORTAL_REPLY=
CLAWBACK_MODEL_COACH=
CLAWBACK_MODEL_RULE_WRITER=

# QuickBooks Online sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
# on (default) or off: watch the sandbox for payments recorded against each account's invoice (api/integrations/qbo_source.py)
QBO_POLL=on

# Remittance inbox (api/inbound_email.py): a Mailgun route forwards every email on INBOUND_EMAIL_DOMAIN to
# https://<DOMAIN>/webhooks/inbound-email. The signing key is Mailgun's HTTP webhook signing key; the domain is the
# receiving subdomain, e.g. in.clawback.biz (each distributor's address is <account id>@<domain>); the folder keeps the
# emails that become documents (the VM: /app/state/inbound, set in docker-compose.yml); forwarders are the addresses
# allowed to forward a remittance in (comma-separated, e.g. the owner's real address)
MAILGUN_WEBHOOK_SIGNING_KEY=
# Dispute email through Mailgun instead (api/integrations/mailgun.py), used only when the Gmail keys aren't set: the
# sending domain, its API key, and https://api.eu.mailgun.net for an EU-region domain (default https://api.mailgun.net)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_BASE=
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_DIR=
INBOUND_EMAIL_FORWARDERS=

# Dispute email (api/dispute_email.py, api/integrations/gmail.py): the supplier's Gmail address and an app password
# (Google Account > Security > 2-Step Verification > App passwords; IMAP on in Gmail's settings). The admin approves
# each email in the app and Clawback sends it from this address (SMTP, smtp.gmail.com:465 SSL). GMAIL_POLL (on by
# default once both are set) reads replies over IMAP every GMAIL_POLL_SECONDS (default 30). Unset: Mailgun below if its
# keys are set, else the in-app outbox
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_POLL=on
GMAIL_POLL_SECONDS=

# Google Drive (api/drive.py): the service account's JSON key (the JSON itself, or a path to the file) and the ID of
# the folder the supplier shared with it (<Supplier>/<Distributor>/{Contracts, Promotions, Remittances, Correspondence,
# Sales data}). DRIVE_DOCS_DIR keeps what it brings in (default <CLAWBACK_STATE_DIR>/drive); DRIVE_POLL=off stops the
# poller; DRIVE_POLL_SECONDS (default 30)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=
DRIVE_DOCS_DIR=
DRIVE_POLL=on
DRIVE_POLL_SECONDS=

# Twilio (trial: the owner's phone must be a verified caller ID; the owner gets the questions and the approvals)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
# sms (default) or whatsapp: the WhatsApp Sandbox, no A2P 10DLC registration; TWILIO_FROM is then the Sandbox number
SMS_CHANNEL=sms

# Capital One Nessie
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
NESSIE_BASE_URL=
NESSIE_POLL=on

# Moss (rule memory, F16): the project ID and project key from the Moss portal (portal.usemoss.dev; redeem code
# CALHACKS on its billing page for credits). MOSS_PROJECT_KEY is Moss's own name; MOSS_API_KEY works too.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_API_KEY=

# Fetch.ai (Agentverse) + read-only token for GET /summary
AGENTVERSE_API_KEY=
CLAWBACK_READONLY_TOKEN=
# The deployed site only: POST /demo/reset needs Authorization: Bearer <this> (make reset CLAWBACK_ADMIN_TOKEN=...)
CLAWBACK_ADMIN_TOKEN=
# The deployed site only (api/auth.py): the admin's in-app answers and approvals need this token
# (X-Clawback-Role-Token); live runs are limited per visitor unless the admin token is sent
OWNER_TOKEN=
# The deployed site only (api/auth.py): the admin signs in with this ID (default "admin") and password; sign-in hands
# the browser OWNER_TOKEN. LOGIN_PER_IP limits attempts per visitor (default 10 per 10 minutes)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Sign-in with tenant isolation (api/users.py, config/users.yaml holds no passwords): Peak Bar's admin
# (dana@peakbar.example) and a second supplier's (teresa@lanternhillsoda.example, Lantern Hill) to show isolation.
# Once any password is set, every account-data route needs the session cookie (POST /auth/login). DEMO_USER2_PHONE is
# the second admin's phone for texts; SESSION_HOURS is how long a sign-in lasts (default 12)
DEMO_USER_PASSWORD=
DEMO_USER2_PASSWORD=
DEMO_USER2_PHONE=
SESSION_HOURS=
LOGIN_PER_IP=
RUNS_PER_IP=
AI_PER_IP=
RUNS_PER_HOUR=
# Clawback Assistant (fetch_agent/README.md): the API it reads, e.g. https://clawback.biz/api; a long secret seed that
# fixes its agent address (never change it once registered); optional comma-separated addresses that may answer
CLAWBACK_API_URL=
CLAWBACK_AGENT_SEED=
CLAWBACK_OWNER_ADDRESSES=

# Elastic (only if that track is added)
ELASTIC_URL=
ELASTIC_API_KEY=

# App
# Deploy (docs/deploy.md): DOMAIN is the bare domain Caddy gets HTTPS for; PUBLIC_BASE_URL=https://<DOMAIN> on the VM
# (Twilio webhook signatures and CORS use it), http://localhost:3000 or the tunnel URL on a laptop
DOMAIN=
PUBLIC_BASE_URL=
DEMO_MODE=false
RECORD_FIXTURES=0
# A server can point a distributor's deductions desk at a real inbox (api/accounts.py), e.g. for a live demo
DESK_EMAIL_PEAK_BAR=
# clawback.biz/video redirects here (the demo video on YouTube)
DEMO_VIDEO_URL=
