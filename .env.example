# Copy to .env and fill in. Never commit .env. Names only here.

# Database (Tiger Data / Tiger Cloud)
DATABASE_URL=

# AI models
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Reader B's model; empty means gemini-2.5-flash (api/agents/reader_b.py)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# One Claude agent on another model, e.g. claude-sonnet-5-5 for the Investigator, checked with make eval-agent; empty
# means claude-opus-5-5 (api/agents/claude.py). READER covers both Claude reads of a document.
CLAWBACK_MODEL_READER=
CLAWBACK_MODEL_INVESTIGATOR=
CLAWBACK_MODEL_REHEARSAL=
CLAWBACK_MODEL_PORTAL_REPLY=
CLAWBACK_MODEL_COACH=
CLAWBACK_MODEL_RULE_WRITER=

# QuickBooks Online sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=

# Twilio (trial: the owner's phone must be a verified caller ID; the owner gets the questions and the approvals)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OWNER_PHONE=
# sms (default) or whatsapp: the WhatsApp Sandbox, no A2P 10DLC registration; TWILIO_FROM is then the Sandbox number
SMS_CHANNEL=sms

# Capital One Nessie
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
NESSIE_BASE_URL=
NESSIE_POLL=on

# Moss (rule memory, F16): the project ID and project key from the Moss portal (portal.usemoss.dev; redeem code
# CALHACKS on its billing page for credits). MOSS_PROJECT_KEY is Moss's own name; MOSS_API_KEY works too.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_API_KEY=

# Fetch.ai (Agentverse) + read-only token for GET /summary
AGENTVERSE_API_KEY=
CLAWBACK_READONLY_TOKEN=
# The deployed site only: POST /demo/reset needs Authorization: Bearer <this> (make reset CLAWBACK_ADMIN_TOKEN=...)
CLAWBACK_ADMIN_TOKEN=
# The deployed site only (api/auth.py): the admin's in-app answers and approvals need this token
# (X-Clawback-Role-Token); live runs are limited per visitor unless the admin token is sent
OWNER_TOKEN=
RUNS_PER_IP=
AI_PER_IP=
RUNS_PER_HOUR=
# Clawback Assistant (fetch_agent/README.md): the API it reads, e.g. https://clawback.biz/api; a long secret seed that
# fixes its agent address (never change it once registered); optional comma-separated addresses that may answer
CLAWBACK_API_URL=
CLAWBACK_AGENT_SEED=
CLAWBACK_OWNER_ADDRESSES=

# Elastic (only if that track is added)
ELASTIC_URL=
ELASTIC_API_KEY=

# App
# Deploy (docs/deploy.md): DOMAIN is the bare domain Caddy gets HTTPS for; PUBLIC_BASE_URL=https://<DOMAIN> on the VM
# (Twilio webhook signatures and CORS use it), http://localhost:3000 or the tunnel URL on a laptop
DOMAIN=
PUBLIC_BASE_URL=
DEMO_MODE=false
RECORD_FIXTURES=0
