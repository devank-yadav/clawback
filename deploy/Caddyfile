# One domain, automatic HTTPS (Let's Encrypt) once DNS points at the VM. DOMAIN comes from .env via docker-compose.yml.
# /api/*      -> FastAPI with the /api prefix stripped (so /api/health is the API's /health)
# /webhooks/* -> FastAPI as is (Twilio signs https://DOMAIN/webhooks/twilio/sms)
# everything else -> Next.js (board, portal, inbox, ...)
# DOMAIN is substituted before parsing, so it may hold two names, e.g. DOMAIN="clawback.biz www.clawback.biz"; each
# needs an A record at the VM first. Laptop fallback: DOMAIN=:80 (plain HTTP behind a tunnel). Runbook: docs/deploy.md.
{$DOMAIN} {
	# One access line per request in `docker compose logs caddy`, e.g. to see whether Twilio's webhook arrived.
	log

	# /video: the demo video (DEMO_VIDEO_URL in .env; the home page until it's set). Changing it reloads only Caddy.
	redir /video {$DEMO_VIDEO_URL} 302

	# The event stream (/api/runs/<id>/events) goes out frame by frame: flushed at once, never compressed.
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /webhooks/* {
		reverse_proxy api:8000
	}

	# Compression only for the web app's pages and assets, so it can never hold back a server-sent event.
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
